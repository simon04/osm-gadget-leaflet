{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "allowJs": true,
    "checkJs": false,
    "maxNodeModuleJsDepth": 10,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "maplair": ["./node_modules/maplair/src/Maplair.js"]
    }
  },
  "include": ["src"]
}
